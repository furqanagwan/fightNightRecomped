<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <Identity Name="ElectronicArts.FIGHTNIGHTCHAMPION"
            Publisher="CN=Electronic Arts Inc."
            Version="1.0.0.0"/>

  <Resources>
    <Resource Language="en-US"/>
  </Resources>

  <ExecutableList>
    <Executable Name="Fight Night Champion.exe"
                Id="Game"
                Alias="FightNightChampion.exe"
                OverrideDisplayName="Fight Night Champion"/>
  </ExecutableList>

  <ShellVisuals DefaultDisplayName="Fight Night Champion"
                PublisherDisplayName="Electronic Arts"
                StoreLogo="StoreLogo.png"
                Square150x150Logo="Logo.png"
                Square44x44Logo="SmallLogo.png"
                SplashScreenImage="SplashScreen.png"
                Description="EA SPORTS boxing, developed by EA Canada and first released on Xbox 360 in March 2011. Native PC recompilation of the Xbox 360 version; runs from your own copy of the game."
                BackgroundColor="#000000"
                ForegroundText="light"/>

  <DesktopRegistration>
    <DependencyList>
      <KnownDependency Name="VC14"/>
    </DependencyList>
    <ProcessorArchitecture>x64</ProcessorArchitecture>
  </DesktopRegistration>
</Game>
